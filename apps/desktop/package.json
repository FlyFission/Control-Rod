{
  "name": "@control-rod/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Control Rod desktop shell wrapping the local Control Rod launcher and web workspace",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "pnpm run build && electron .",
    "pack:dir": "electron-builder --config electron-builder.config.mjs --dir",
    "pack:mac": "electron-builder --config electron-builder.config.mjs --mac dmg"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
