{
  "name": "@control-rod/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../../spec/generated/openapi/openapi.json -o src/api/schema.d.ts",
    "dev": "pnpm gen:api && vite",
    "build": "pnpm check:themes && pnpm check:office && pnpm gen:api && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "pnpm gen:api && tsc -p tsconfig.json --noEmit",
    "test": "pnpm gen:api && vitest run",
    "check:themes": "python3 ../../tools/check_theme_assets.py --root ../..",
    "check:office": "vitest run src/features/office/contract.test.ts",
    "test:themes:browser": "playwright test",
    "dev:themes": "pnpm gen:api && vite --open /themes.html"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "26.1.0",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
