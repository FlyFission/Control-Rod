# cr-bench-bwrap: the AppArmor profile for the benchmark's agent containers.
#
# It is Docker's docker-default profile with two changes, so that each CLI's own bubblewrap
# sandbox can start inside an unprivileged container (the approach Ubuntu itself takes for bwrap
# in /etc/apparmor.d/bwrap-userns-restrict):
#   1. "userns," is allowed, and
#   2. docker-default's blanket "deny mount," is replaced by the mount, pivot_root and umount
#      shapes bubblewrap uses (an AppArmor deny always wins over an allow, so it cannot stay).
# Every other docker-default deny rule is kept unchanged. The container keeps --cap-drop ALL and
# no-new-privileges, so these mounts take effect only inside the sandbox's own user and mount
# namespaces. Found on the owner's Colima VM (Ubuntu kernel 6.8,
# kernel.apparmor_restrict_unprivileged_userns=1) by iterating against the kernel's denial log;
# bwrap mounts with "rw, silent, rslave", and "/**" does not match "/", hence "/{,**}".
# Load inside the VM: sudo apparmor_parser -r cr-bench-bwrap.apparmor (remove with -R).

abi <abi/4.0>,
include <tunables/global>

profile cr-bench-bwrap flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=cr-bench-bwrap,

  # added for bwrap
  userns,
  mount options in (rw, silent, rslave, rprivate, slave, private) /{,**},
  mount options in (rw, ro, nosuid, nodev, noexec, remount, bind, rbind, silent, relatime, strictatime) /{,**} -> /{,**},
  mount options in (rw, ro, nosuid, nodev, noexec, remount, bind, silent, relatime, strictatime) -> /{,**},
  mount fstype=proc -> /{,**},
  mount fstype=tmpfs -> /{,**},
  mount fstype=devpts -> /{,**},
  pivot_root,

  # docker-default deny rules, unchanged (except "deny mount," which is replaced above)
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=cr-bench-bwrap,
}
