{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "PasskeyAssertion.json",
    "type": "object",
    "properties": {
        "credential_id": {
            "type": "string"
        },
        "authenticator_data": {
            "type": "string"
        },
        "client_data_json": {
            "type": "string"
        },
        "signature": {
            "type": "string"
        }
    },
    "required": [
        "credential_id",
        "authenticator_data",
        "client_data_json",
        "signature"
    ],
    "description": "A WebAuthn assertion over the decision digest, made by the person's own authenticator.",
    "unevaluatedProperties": false
}