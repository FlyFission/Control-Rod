{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Run.json",
    "type": "object",
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "0.1.0"
        },
        "id": {
            "type": "string"
        },
        "package_id": {
            "type": "string"
        },
        "package_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
        },
        "role": {
            "$ref": "RunRole.json"
        },
        "agent_baseline": {
            "type": "string"
        },
        "runtime": {
            "$ref": "RuntimeRef.json"
        },
        "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Author and pre-check rounds start at 1; round 3 escalates a dispute to a person."
        },
        "status": {
            "$ref": "RunStatus.json"
        },
        "queued_at": {
            "type": "string",
            "format": "date-time"
        },
        "started_at": {
            "type": "string",
            "format": "date-time"
        },
        "finished_at": {
            "type": "string",
            "format": "date-time"
        },
        "label": {
            "type": "string",
            "maxLength": 120,
            "description": "Short label the runner writes for the office view. Never raw model text."
        },
        "error": {
            "type": "string"
        },
        "trace": {
            "$ref": "ExecutionTrace.json"
        },
        "lease_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "While running: when the claim lapses unless the daemon renews it with a log post."
        },
        "requeue_of": {
            "type": "string",
            "description": "The run this one was requeued from, after it was lost, failed or stopped."
        },
        "requeued_as": {
            "type": "string",
            "description": "The run the owner queued to replace this one."
        },
        "stop_requested_at": {
            "type": "string",
            "format": "date-time",
            "description": "The owner asked to stop this run. It shows as stopping until the daemon confirms."
        },
        "stop_requested_by": {
            "type": "string"
        },
        "waiting_reason": {
            "type": "string",
            "maxLength": 300,
            "description": "Why a queued run is not being handed out, in plain words."
        },
        "independence_override": {
            "$ref": "OwnerOverride.json",
            "description": "The owner let this pre-check run on the author's runtime. Recorded before it ran."
        }
    },
    "required": [
        "schema_version",
        "id",
        "package_id",
        "package_revision",
        "role",
        "agent_baseline",
        "runtime",
        "round",
        "status",
        "queued_at"
    ],
    "description": "One agent session working on one package revision in one role.",
    "unevaluatedProperties": false
}