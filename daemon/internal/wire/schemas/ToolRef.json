{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ToolRef.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string"
        },
        "digest": {
            "$ref": "Digest.json",
            "description": "SHA-256 of the executable that ran (specification 21: runs launch a verified artifact)."
        },
        "qualification": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "not-required"
                },
                {
                    "type": "string",
                    "const": "required-before-use"
                },
                {
                    "type": "string",
                    "const": "qualified"
                }
            ]
        }
    },
    "required": [
        "name"
    ],
    "unevaluatedProperties": false
}