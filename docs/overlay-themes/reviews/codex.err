    25	        if tag not in ELEMENTS:
    26	            errors.append(f'Forbidden SVG element {tag}')
    27	        for key, value in node.attrib.items():
    28	            name = key.split('}')[-1]
    29	            if name not in ATTRS:
    30	                errors.append(f'Forbidden attribute {name}')
    31	            if name == 'href' and not re.fullmatch(r'#[\w-]+', value):
    32	                errors.append('Only local fragment hrefs are permitted')
    33	            if 'url(' in value.lower() and not re.fullmatch(r'url\(#[\w-]+\)', value):
    34	                errors.append('Only local paint/clip references are permitted')
    35	            if re.search(r'(?:https?:|data:|javascript:|file:|//)', value, re.I):
    36	                errors.append('External references are forbidden')
    37	    if tree.tag.split('}')[-1] != 'svg':
    38	        errors.append('Root must be SVG')
    39	    return errors
