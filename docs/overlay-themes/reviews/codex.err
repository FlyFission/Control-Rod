   215	def extras(world, v, palette):
   216	    """Replacement accessory markup for worlds whose shared robot antenna no longer fits, or None."""
   217	    a, b, c, d = palette
   218	    if world == CONFECTIONERY:
   219	        seat = [10, 2, 14, 4, 8, 0][v]
   220	        return (
   221	            f'<g transform="translate(0 {seat})"><path d="M42 31q-10-13 4-17 3-13 17-5 16-8 18 7 12 5 3 16z" fill="#fbf6ec"/>'
   222	            f'<path d="M44 32h39" stroke="{c}" stroke-width="4"/></g>'
   223	            f'<path d="M56 84l8 9 8-9z" fill="{c}"/>'
   224	        )
   225	    if world in (CREATURE, POCKET_LAB, BUREAU, LANTERNWOOD, CAFE, TUMBLETOWN, WILDLIGHT, VOXEL, CLOUDSPRING, BUTTON, CORAL, MEADOW):
   226	        return ''
   227	    if world == ORBITAL:
   228	        return f'<path d="M21 72l-8-15 8-12M106 73l10-12-10-14" fill="none" stroke="{d}" stroke-width="3"/>'
   229	    if world == CLOCKWORK:
   230	        return f'<circle cx="94" cy="40" r="7" fill="{c}" stroke="{d}" stroke-width="2"/><path d="M94 35v5l3 2" fill="none" stroke="#273f53" stroke-width="1.5"/>'
   231	    return None
     1	"""Named prop drawings for the overlay worlds.
     2	
     3	Each catalog brief names six props per world. Every name maps to exactly one
     4	original drawing on a 128 by 128 canvas; worlds that share a prop name (for
     5	example a lantern) share its drawing in their own palette. Drawings use only
     6	passive SVG shapes so they pass tools/check_theme_assets.py.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	
    12	def _doc(a, b, c, d, lines=3, fold=True, tab=False, x=34, y=30, w=60, h=74):
    13	    s = f'<path d="M{x} {y}h{w-16}l16 16v{h-16}H{x}z" fill="{d}" stroke="{b}" stroke-width="3"/>' if fold else f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="4" fill="{d}" stroke="{b}" stroke-width="3"/>'
    14	    if fold:
    15	        s += f'<path d="M{x+w-16} {y}v16h16" fill="{b}"/>'
    16	    if tab:
    17	        s += f'<path d="M{x+6} {y}v-8h20l4 8" fill="{c}"/>'
    18	    for i in range(lines):
    19	        s += f'<path d="M{x+10} {y+30+i*11}h{w-20-(i%2)*10}" stroke="{a}" stroke-width="4" stroke-linecap="round"/>'
    20	    return s
    21	
    22	
    23	PROPS = {
    24	    # Documents and cards
