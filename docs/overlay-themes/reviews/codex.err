   290	            data=value.encode();sha=hashlib.sha256(data).hexdigest();name=f'{key}.{sha[:12]}.svg'
   291	            (public/name).write_bytes(data);(source/f'{key}.svg').write_bytes(data)
   292	            w,h=(1000,600) if key=='scene' else (800,480) if key=='thumbnail' else (128,128)
   293	            assets.append(dict(key=key,path=name,sha256=sha,bytes=len(data),width=w,height=h,creator='Original procedural vector illustration (Codex, Claude Code)',rightsBasis='original',licenseNoticeId='Apache-2.0'))
   294	        current_names={a['path'] for a in assets}
