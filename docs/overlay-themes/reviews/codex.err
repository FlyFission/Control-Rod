   283	            char=char.replace('width="128" height="128"','width="110" height="110"')
   284	            inner+=char
   285	        thumbnail=svg(inner,800,480,'0 0 1000 600')
   286	        raw_assets={'scene':background,'thumbnail':thumbnail,**{f'character-{i}':c for i,c in enumerate(chars)},**{f'prop-{i}':prop(name,palette) for i,name in enumerate(propnames)}}
   287	        previous=json.loads((public/'assets.json').read_text())['assets'] if (public/'assets.json').exists() else []
   288	        assets=[]
