   239	        for rx, rw in [(110, 200), (450, 240), (790, 200)]:
   240	            s += (f'<path d="M{rx} 90q{rw//2}-30 {rw} 0l-14 16H{rx+14}z" fill="{mix(a, .4)}" stroke="{c}" stroke-width="3"/>'
   241	                  f'<path d="M{rx+16} 64q{(rw-32)//2}-24 {rw-32} 0l-12 14H{rx+28}z" fill="{mix(a, .5)}" stroke="{c}" stroke-width="2"/>')
   242	        # Billowing, swirling clouds of warm white mineral steam
