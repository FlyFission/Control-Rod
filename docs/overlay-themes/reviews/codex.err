    78	        except ET.ParseError:
    79	            pass
    80	        if not a.get('creator') or not a.get('licenseNoticeId') or a.get('rightsBasis') not in {'original','licensed','public-domain'}:
    81	            errors.append(f'{key}: missing provenance')
    82	        if key == 'thumbnail' and len(raw) > 100*1024:
    83	            errors.append('Thumbnail exceeds 100 KiB')
    84	        total += len(raw)
    85	    if total > 1024*1024:
