   301	        (source/'source.json').write_text(json.dumps({'packId':pid,'generator':'tools/build_theme_art.py','palette':palette,'status':'draft','props':propnames,'sourceAssets':'Editable SVG siblings; identical geometry to hashed public exports'},indent=2)+'\n')
   302	        def ref(key):
