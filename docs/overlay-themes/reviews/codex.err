   122	def prop_shape(name: str, palette: list[str]) -> str:
   123	    a, b, c, d = palette
   124	    if name not in PROPS:
   125	        raise KeyError(f"no drawing for prop {name!r}; add one to tools/theme_art_props.py")
   126	    return PROPS[name](a, b, c, d)

