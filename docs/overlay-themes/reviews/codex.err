    26	        # Overhead suspended conveyor rail with door clamps
    27	        s += f'<path d="M0 80h1000" stroke="{mix(a, .7)}" stroke-width="5"/>'
    28	        for x in (110, 290, 480, 660, 850):
    29	            s += (f'<rect x="{x}" y="80" width="10" height="18" fill="{c}"/>'
    30	                  f'<rect x="{x-14}" y="98" width="38" height="48" rx="4" fill="{mix(b, .3)}" stroke="{mix(d, .5)}" stroke-width="2"/>'
    31	                  f'<circle cx="{x+5}" cy="122" r="3" fill="{accent}"/>')
    32	        # Three vertical pneumatic glass transfer tubes
    33	        for tx in (180, 500, 820):
    34	            s += (f'<rect x="{tx}" y="0" width="22" height="600" fill="{mix(a, .25)}" stroke="{mix(a, .5)}" stroke-width="2" opacity=".4"/>'
    35	                  f'<path d="M{tx} 150h22M{tx} 270h22M{tx} 420h22" stroke="{c}" stroke-width="4"/>'
    36	                  # Glowing capsule parcel inside tube
    37	                  f'<rect x="{tx+3}" y="200" width="16" height="34" rx="8" fill="{d}" stroke="{c}" stroke-width="2" opacity=".8"/>'
    38	                  f'<rect x="{tx+3}" y="350" width="16" height="34" rx="8" fill="{c}" stroke="{d}" stroke-width="2" opacity=".8"/>')
    39	        # Heavy steel tread pattern along bottom
    40	        for x in range(0, 1000, 40):
    41	            s += f'<path d="M{x} 580l15 20M{x+10} 580l15 20" stroke="{mix(b, .4)}" stroke-width="2" opacity=".3"/>'
    42	
    43	    elif world == 1:
    44	        # Little Helpers Laboratory: massive distillation coils, chalkboard schematics, pressure pipes
    45	        # Overhead copper steam piping with round analog pressure gauges
    46	        s += f'<path d="M0 35h1000M0 45h1000" stroke="{mix(c, .7)}" stroke-width="3"/>'
    47	        for gx in (220, 500, 780):
    48	            s += (f'<circle cx="{gx}" cy="40" r="14" fill="{d}" stroke="{b}" stroke-width="2"/>'
