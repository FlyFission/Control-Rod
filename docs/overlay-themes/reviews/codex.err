   228	            s += voxel_cube(vx, 110 - voxel_h, 24, top_col=d, left_col=mix(a, .6), right_col=mix(b, .6))
   229	            s += voxel_cube(vx + 16, 122 - voxel_h, 24, top_col=c, left_col=mix(a, .5), right_col=mix(b, .5))
   230	        # Voxel conveyor belt carrying colorful resource cubes across the promenade
