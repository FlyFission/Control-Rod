    58	def character(world,v,palette):
    59	    a,b,c,d=palette
    60	    bodycolors=[a,b,c,mix(a,.65,(220,215,190)),mix(c,.7,(180,210,205)),mix(b,.6,(200,220,210))]
    61	    color=bodycolors[v]
    62	    grad=f'<defs><linearGradient id="body{v}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="{mix(color,.65,(255,255,235))}"/><stop offset="1" stop-color="{color}"/></linearGradient></defs>'
    63	    fill=f'url(#body{v})'
