    42	def check_manifest(directory, manifest, complete=True):
    43	    errors, total, seen = [], 0, set()
    44	    assets = manifest.get('assets', [])
    45	    if complete:
    46	        if manifest.get('schemaVersion') != 1 or not manifest.get('packId') or not manifest.get('version'):
    47	            errors.append('Missing or incompatible pack metadata')
    48	        required = {'scene', 'thumbnail'} | {f'character-{i}' for i in range(6)} | {f'prop-{i}' for i in range(6)}
    49	        if {a.get('key') for a in assets} != required:
    50	            errors.append('Complete pack requires scene, thumbnail, six characters and six props')
    51	    for a in assets:
    52	        key = a.get('key')
    53	        if key in seen:
    54	            errors.append(f'Duplicate asset key {key}')
    55	        seen.add(key)
    56	        relative = Path(a.get('path', ''))
    57	        path = directory / relative
    58	        if relative.is_absolute() or '..' in relative.parts or any((directory/Path(*relative.parts[:i+1])).is_symlink() for i in range(len(relative.parts))):
    59	            errors.append(f'{key}: escaping or symlink path')
    60	            continue
    61	        if not path.is_file() or not path.resolve().is_relative_to(directory.resolve()):
    62	            errors.append(f'{key}: missing or escaping file')
    63	            continue
    64	        if path.stat().st_size > 1024*1024:
    65	            errors.append(f'{key}: asset too large')
    66	            continue
