    48	def catalog_props():
    49	    """Six prop names per pack ID, read from the catalog brief."""
    50	    text=(ROOT/'docs/superpowers/specs/2026-10-25-overlay-themes-catalog.md').read_text()
    51	    props={}
    52	    for section in re.split(r'\n## \d+\. ',text)[1:]:
    53	        ident=re.search(r'ID `([a-z0-9-]+)`',section);line=re.search(r'\*\*Props:\*\*\s*(.+)',section)
    54	        if ident and line:props[ident.group(1)]=[x.strip() for x in line.group(1).rstrip('.').split(',')]
    55	    return props
