   168	        # Looping spiraling roller conveyor ramps
   169	        s += f'<path d="M0 120q250 80 500-20t500 40" fill="none" stroke="{c}" stroke-width="7"/>'
   170	        for rx in range(60, 960, 110):
   171	            s += f'<rect x="{rx}" y="110" width="16" height="14" rx="3" fill="{d}" stroke="{b}" stroke-width="2"/>'
   172	
   173	    elif world == 7:
   174	        # Starport Shipyard: vast orbital hangar bay looking out at curved planet & starfield, gantry cranes
