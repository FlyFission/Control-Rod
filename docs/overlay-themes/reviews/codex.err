    75	            f'<path d="M42 58Q5 20 10 72q1 26 35 10M84 58q37-38 32 14-1 26-35 10" fill="{b}"/><ellipse cx="64" cy="67" rx="24" ry="37" fill="{fill}"/><path d="M53 30l-8-14M73 30l9-14" stroke="{c}" stroke-width="4"/>',
