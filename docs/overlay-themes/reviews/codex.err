    27	def mix(hexcolor, ratio, base=(15,25,35)):
    28	    rgb = tuple(int(hexcolor[i:i+2],16) for i in (1,3,5))
    29	    return '#' + ''.join(f'{round(c*ratio+b*(1-ratio)):02x}' for c,b in zip(rgb,base))
    30	
    31	
    32	def svg(body, width=128, height=128, viewbox=None):
    33	    return f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="{viewbox or f"0 0 {width} {height}"}">{body}</svg>'
    34	
    35	
    36	def star(x,y,r,color):
    37	    return f'<path d="M{x} {y-r}l{r*.28} {r*.72} {r*.72} {r*.28}-{r*.72} {r*.28}-{r*.28} {r*.72}-{r*.28}-{r*.72}-{r*.72}-{r*.28} {r*.72}-{r*.28}z" fill="{color}"/>'
    38	
    39	
    40	def leaf(x,y,size,color,angle=0):
    41	    return f'<path d="M0 0Q{-size} {-size} 0 {-size*1.8}Q{size} {-size} 0 0Z" fill="{color}" transform="translate({x} {y}) rotate({angle})"/>'
    42	
    43	
    44	def prop(name,palette):
    45	    return svg('<ellipse cx="64" cy="110" rx="37" ry="6" fill="#0a1824" opacity=".2"/>'+prop_shape(name,palette))
    46	
