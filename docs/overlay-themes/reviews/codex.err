     1	"""World specific character bodies.
     2	
     3	tools/build_theme_art.py began with shared body templates that several worlds
     4	reused. These overrides give every world its own body geometry, designed from
     5	its catalog cast list; faces, legs and handheld tools stay a shared house
     6	style. Each body is wrapped in <g id="shape-N">; tools/test_check_theme_assets.py
     7	fails if any body shape appears in more than one world.
     8	
     9	World index follows the catalog order in apps/web/src/features/floor/themes/catalog.ts.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	CREATURE, POCKET_LAB, BUREAU = 0, 1, 2
    15	CONFECTIONERY, LANTERNWOOD, CAFE, TUMBLETOWN, ORBITAL = 3, 4, 5, 6, 7
    16	WILDLIGHT, VOXEL, CLOUDSPRING = 8, 9, 10
    17	BUTTON, CLOCKWORK, CORAL, MEADOW = 11, 12, 13, 14
    18	
    19	
    20	def _human(coat, head, hair, fill, skin, haircolor):
    21	    cx, cy, rx, ry = head
    22	    return (
    23	        f'<path d="{coat}" fill="{fill}"/>'
    24	        f'<ellipse cx="{cx}" cy="{cy}" rx="{rx}" ry="{ry}" fill="{skin}"/>'
    25	        f'<path d="{hair}" fill="{haircolor}"/>'
    26	    )
    27	
    28	
    29	# Café: everyday clothes, one silhouette per regular.
    30	CAFE_COATS = [
    31	    "M30 103l8-42q26-16 52 0l8 42H70V64H58v39z",
    32	    "M32 103l7-41q25-17 50 0l7 41z",
    33	    "M28 103l8-38q28-22 56 0l8 38zM42 60q22-16 44 0q-22 10-44 0z",
    34	    "M30 103l10-44 24 20 24-20 10 44z",
    35	    "M34 103l6-42q24-12 48 0l6 42zM54 52h20v10H54z",
