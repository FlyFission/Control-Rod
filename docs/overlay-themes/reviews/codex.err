    50	        # Giant green chalkboard panel in upper center
    51	        s += (f'<rect x="330" y="58" width="340" height="48" rx="4" fill="#1b3628" stroke="{mix(b, .6)}" stroke-width="3"/>'
    52	              # Chalk formula drawings, gears, atomic orbits
    53	              f'<circle cx="380" cy="82" r="12" fill="none" stroke="{d}" stroke-width="1.5" stroke-dasharray="3 3"/>'
    54	              f'<ellipse cx="380" cy="82" rx="16" ry="6" fill="none" stroke="{d}" stroke-width="1" transform="rotate(30 380 82)"/>'
    55	              f'<path d="M420 75l14 14-8 4 12 6" fill="none" stroke="{c}" stroke-width="2"/>'
