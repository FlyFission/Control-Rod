   249	
   250	def preflight(entries,briefs):
   251	    """Every problem that would stop the build, found before any file is written."""
   252	    from theme_art_props import PROPS
   253	    problems=[]
   254	    ids=[e['id'] for e in entries]
   255	    if len(set(ids))!=len(ids):problems.append('duplicate pack IDs in catalog.ts')
   256	    for pid in ids:
   257	        names=briefs.get(pid)
   258	        if names is None:problems.append(f'{pid}: no prop brief in the catalog spec');continue
   259	        if len(names)!=6:problems.append(f'{pid}: prop brief lists {len(names)} props; exactly six are required')
   260	        for name in names:
   261	            if name not in PROPS:problems.append(f'{pid}: no drawing for prop {name!r} in tools/theme_art_props.py')
   262	    for pid in sorted(set(briefs)-set(ids)):problems.append(f'{pid}: prop brief has no catalog entry')
   263	    return problems
   264	
   265	
   266	def main():
   267	    catalogpath=ROOT/'apps/web/src/features/floor/themes/catalog.ts'
   268	    content=catalogpath.read_text()
   269	    entries=json.loads(content.split(' = ',1)[1].rsplit(';',1)[0])
   270	    packdir=ROOT/'apps/web/src/features/floor/themes/packs';packdir.mkdir(exist_ok=True)
   271	    briefs=catalog_props()
   272	    problems=preflight(entries,briefs)
   273	    if problems:
   274	        raise SystemExit('Nothing written; fix these first:\n'+'\n'.join(problems))
   275	    for world,entry in enumerate(entries):
   276	        pid=entry['id'];palette=entry['palette'];propnames=briefs[pid]
   277	        public=ROOT/f'apps/web/public/floor-themes/{pid}';public.mkdir(parents=True,exist_ok=True)
   278	        source=ROOT/f'design/overlay-themes/{pid}';source.mkdir(parents=True,exist_ok=True)
   279	        background=scene(world,entry);chars=[character(world,v,palette) for v in range(6)]
   280	        inner=background.split('>',1)[1].rsplit('</svg>',1)[0]
   281	        for i,(key,r) in enumerate(STATIONS.items()):
   282	            char=chars[i].replace('<svg ',f'<svg x="{r["x"]+r["w"]*.5-55}" y="{r["y"]+66}" ')
   283	            char=char.replace('width="128" height="128"','width="110" height="110"')
   284	            inner+=char
   285	        thumbnail=svg(inner,800,480,'0 0 1000 600')
   286	        raw_assets={'scene':background,'thumbnail':thumbnail,**{f'character-{i}':c for i,c in enumerate(chars)},**{f'prop-{i}':prop(name,palette) for i,name in enumerate(propnames)}}
   287	        previous=json.loads((public/'assets.json').read_text())['assets'] if (public/'assets.json').exists() else []
   288	        assets=[]
   289	        for key,value in raw_assets.items():
   290	            data=value.encode();sha=hashlib.sha256(data).hexdigest();name=f'{key}.{sha[:12]}.svg'
   291	            (public/name).write_bytes(data);(source/f'{key}.svg').write_bytes(data)
   292	            w,h=(1000,600) if key=='scene' else (800,480) if key=='thumbnail' else (128,128)
   293	            assets.append(dict(key=key,path=name,sha256=sha,bytes=len(data),width=w,height=h,creator='Original procedural vector illustration (Codex, Claude Code)',rightsBasis='original',licenseNoticeId='Apache-2.0'))
   294	        current_names={a['path'] for a in assets}
   295	        for old in previous:
   296	            if old['path'] not in current_names and Path(old['path']).name==old['path']:
   297	                (public/old['path']).unlink(missing_ok=True)
   298	        manifest=dict(schemaVersion=1,packId=pid,version='0.1.0',title=entry['title'],assets=assets)
   299	        (public/'assets.json').write_text(json.dumps(manifest,indent=2)+'\n')
   300	        (public/'NOTICE.txt').write_text('Original Control-Rod vector artwork, authored in tools/build_theme_art.py.\nLicensed under Apache-2.0. No franchise characters, reference images, fonts or audio are included.\nDraft artwork; human art/distribution review remains pending.\n')
   301	        (source/'source.json').write_text(json.dumps({'packId':pid,'generator':'tools/build_theme_art.py','palette':palette,'status':'draft','props':propnames,'sourceAssets':'Editable SVG siblings; identical geometry to hashed public exports'},indent=2)+'\n')
   302	        def ref(key):
   303	            a=next(a for a in assets if a['key']==key)
   304	            return {k:v for k,v in {**a,'path':f'/floor-themes/{pid}/{a["path"]}'}.items() if k!='key'}
   305	        pack=dict(schemaVersion=1,id=pid,version='0.1.0',title=entry['title'],description=entry['description'],moodTags=entry['moodTags'],availability='development',tokens=dict(backdrop=mix(palette[0],.18),surface=mix(palette[0],.32),ink='#ffffff',mutedInk='#d4e0eb',accent=palette[2],focus='#ffffff'),assets=dict(scene=ref('scene'),thumbnail=ref('thumbnail'),characters=[ref(f'character-{i}') for i in range(6)],props={f'prop-{i}':ref(f'prop-{i}') for i in range(6)}),stations={key:{**value,'label':entry['stationLabels'][key]} for key,value in STATIONS.items()},motionProfile='shared-v1',signature=entry['signature'],credits=['Original Control-Rod vector artwork · Apache-2.0'])
   306	        (packdir/f'{pid}.ts').write_text('import type { ThemePackV1 } from "../types.js";\nexport default '+json.dumps(pack,indent=2)+' satisfies ThemePackV1;\n')
   307	        entry['thumbnail']=ref('thumbnail')['path']
   308	    catalogpath.write_text('import type { ThemeRegistryEntry } from "./types.js";\nexport const THEME_CATALOG: readonly ThemeRegistryEntry[] = '+json.dumps(entries,indent=2)+';\n')
   309	    print('Built fifteen original draft worlds, ninety characters and ninety props with reproducible sources and SHA-256 manifests.')
   310	
   311	
   312	if __name__=='__main__': main()
     1	"""World-specific architectural backdrops and station styling for overlay themes.
     2	
     3	Authored to evoke the specific creative lineage of each world with unmistakable
     4	atmosphere while adhering to docs/overlay-themes/originality.md (original vector
     5	geometry only, no trademarked marks, logos, character likenesses, or external assets).
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	
    11	def mix(hexcolor: str, ratio: float, base=(15, 25, 35)) -> str:
    12	    rgb = tuple(int(hexcolor[i:i+2], 16) for i in (1, 3, 5))
    13	    return '#' + ''.join(f'{round(c * ratio + b * (1 - ratio)):02x}' for c, b in zip(rgb, base))
    14	
    15	
    16	def backdrop(world: int, a: str, b: str, c: str, d: str, dark: str, light: str, accent: str, rng) -> str:
    17	    """Generate the rich world-specific architectural scenery behind the floor stations."""
    18	    s = ''
    19	
    20	    if world == 0:
    21	        # The Monster Mailroom: industrial pneumatic dispatch warehouse, overhead door tracks & delivery tubes
    22	        # Ceiling girder truss
    23	        s += f'<path d="M0 45h1000M0 55h1000" stroke="{mix(b, .4)}" stroke-width="3"/>'
    24	        for x in range(30, 1000, 60):
    25	            s += f'<path d="M{x} 45l30 10M{x+30} 45l-30 10" stroke="{mix(b, .35)}" stroke-width="2"/>'
    26	        # Overhead suspended conveyor rail with door clamps
    27	        s += f'<path d="M0 80h1000" stroke="{mix(a, .7)}" stroke-width="5"/>'
    28	        for x in (110, 290, 480, 660, 850):
    29	            s += (f'<rect x="{x}" y="80" width="10" height="18" fill="{c}"/>'
    30	                  f'<rect x="{x-14}" y="98" width="38" height="48" rx="4" fill="{mix(b, .3)}" stroke="{mix(d, .5)}" stroke-width="2"/>'
    31	                  f'<circle cx="{x+5}" cy="122" r="3" fill="{accent}"/>')
    32	        # Three vertical pneumatic glass transfer tubes
    33	        for tx in (180, 500, 820):
    34	            s += (f'<rect x="{tx}" y="0" width="22" height="600" fill="{mix(a, .25)}" stroke="{mix(a, .5)}" stroke-width="2" opacity=".4"/>'
    35	                  f'<path d="M{tx} 150h22M{tx} 270h22M{tx} 420h22" stroke="{c}" stroke-width="4"/>'
    36	                  # Glowing capsule parcel inside tube
    37	                  f'<rect x="{tx+3}" y="200" width="16" height="34" rx="8" fill="{d}" stroke="{c}" stroke-width="2" opacity=".8"/>'
    38	                  f'<rect x="{tx+3}" y="350" width="16" height="34" rx="8" fill="{c}" stroke="{d}" stroke-width="2" opacity=".8"/>')
    39	        # Heavy steel tread pattern along bottom
    40	        for x in range(0, 1000, 40):
    41	            s += f'<path d="M{x} 580l15 20M{x+10} 580l15 20" stroke="{mix(b, .4)}" stroke-width="2" opacity=".3"/>'
    42	
    43	    elif world == 1:
    44	        # Little Helpers Laboratory: massive distillation coils, chalkboard schematics, pressure pipes
    45	        # Overhead copper steam piping with round analog pressure gauges
    46	        s += f'<path d="M0 35h1000M0 45h1000" stroke="{mix(c, .7)}" stroke-width="3"/>'
    47	        for gx in (220, 500, 780):
    48	            s += (f'<circle cx="{gx}" cy="40" r="14" fill="{d}" stroke="{b}" stroke-width="2"/>'
    49	                  f'<path d="M{gx} 40l6-6" stroke="{c}" stroke-width="2"/><circle cx="{gx}" cy="40" r="2" fill="{a}"/>')
    50	        # Giant green chalkboard panel in upper center
    51	        s += (f'<rect x="330" y="58" width="340" height="48" rx="4" fill="#1b3628" stroke="{mix(b, .6)}" stroke-width="3"/>'
    52	              # Chalk formula drawings, gears, atomic orbits
    53	              f'<circle cx="380" cy="82" r="12" fill="none" stroke="{d}" stroke-width="1.5" stroke-dasharray="3 3"/>'
    54	              f'<ellipse cx="380" cy="82" rx="16" ry="6" fill="none" stroke="{d}" stroke-width="1" transform="rotate(30 380 82)"/>'
    55	              f'<path d="M420 75l14 14-8 4 12 6" fill="none" stroke="{c}" stroke-width="2"/>'
    56	              f'<path d="M470 74h45M470 82h35M470 90h25" stroke="{d}" stroke-width="2" stroke-linecap="round"/>'
    57	              f'<circle cx="560" cy="82" r="10" fill="none" stroke="{d}" stroke-width="2"/>'
    58	              f'<path d="M560 68v28M546 82h28" stroke="{d}" stroke-width="2"/>'
    59	              f'<path d="M600 72l12 10-6 2 10 10" fill="none" stroke="{accent}" stroke-width="2"/>')
    60	        # Giant bubbling glass condenser tube
    61	        s += f'<path d="M70 55q40-20 80 0t80 0" fill="none" stroke="{d}" stroke-width="6" opacity=".5"/>'
    62	        for bx in range(85, 230, 25):
    63	            s += f'<circle cx="{bx}" cy="55" r="4" fill="{c}" opacity=".7"/>'
    64	
    65	    elif world == 2:
    66	        # Heist Night: penthouse glass window overlooking midnight skyline, laser beams, marble floor
    67	        # Midnight skyscraper silhouettes with glowing window matrices
    68	        skyline_x = [40, 110, 190, 270, 360, 450, 540, 630, 720, 810, 900]
    69	        skyline_w = [60, 70, 65, 80, 75, 85, 70, 80, 75, 70, 75]
    70	        skyline_h = [170, 210, 150, 230, 190, 250, 180, 220, 160, 240, 180]
    71	        for sx, sw, sh in zip(skyline_x, skyline_w, skyline_h):
    72	            s += f'<rect x="{sx}" y="{270-sh}" width="{sw}" height="{sh}" fill="{mix(b, .15)}" stroke="{mix(b, .3)}" stroke-width="1"/>'
    73	            # Lit window grid dots
    74	            for wy in range(290 - sh, 250, 16):
    75	                for wx in range(sx + 8, sx + sw - 8, 12):
    76	                    if (wx + wy) % 5 != 0:
    77	                        s += f'<rect x="{wx}" y="{wy}" width="4" height="6" fill="{d}" opacity=".4"/>'
    78	        # Spire towers with red beacon lights
    79	        for tx in (145, 487, 845):
    80	            s += (f'<line x1="{tx}" y1="40" x2="{tx}" y2="70" stroke="{mix(d, .6)}" stroke-width="2"/>'
    81	                  f'<circle cx="{tx}" cy="40" r="3" fill="#ff4444"/>')
    82	        # Sweeping searchlight beams
    83	        s += (f'<polygon points="145,40 0,0 60,0" fill="{c}" opacity=".08"/>'
    84	              f'<polygon points="845,40 940,0 1000,0" fill="{c}" opacity=".08"/>')
    85	        # Faint cyan laser tripwires slicing through vault
    86	        s += (f'<line x1="0" y1="90" x2="1000" y2="130" stroke="{c}" stroke-width="1.5" stroke-dasharray="12 4" opacity=".5"/>'
    87	              f'<line x1="0" y1="210" x2="1000" y2="170" stroke="{c}" stroke-width="1.5" stroke-dasharray="16 6" opacity=".4"/>')
    88	        # Polished architectural marble columns
    89	        for cx in (330, 670):
    90	            s += f'<rect x="{cx}" y="0" width="8" height="600" fill="{mix(a, .4)}" stroke="{mix(c, .3)}" stroke-width="1"/>'
    91	
    92	    elif world == 3:
    93	        # The Chocolate Factory: whimsical candy hills, giant lollipop trees, looping brass syrup pipes
    94	        # Rolling candy swirl horizon in background
    95	        s += (f'<path d="M0 270q150-70 320 0t360-50 320 50v20H0z" fill="{mix(b, .25)}"/>'
    96	              f'<path d="M0 270q150-70 320 0t360-50 320 50" fill="none" stroke="{c}" stroke-width="4" opacity=".4"/>')
    97	        # Giant spiral lollipop tree silhouettes
    98	        for lx, ly, lr in [(120, 170, 36), (490, 150, 42), (860, 160, 38)]:
    99	            s += (f'<rect x="{lx-3}" y="{ly}" width="6" height="100" fill="{d}"/>'
   100	                  f'<circle cx="{lx}" cy="{ly}" r="{lr}" fill="{b}" stroke="{c}" stroke-width="4"/>'
   101	                  f'<circle cx="{lx}" cy="{ly}" r="{lr-10}" fill="none" stroke="{d}" stroke-width="3"/>'
   102	                  f'<circle cx="{lx}" cy="{ly}" r="{lr-20}" fill="none" stroke="{c}" stroke-width="3"/>')
   103	        # Looping overhead brass/copper candy syrup pipe with glass globes
   104	        s += (f'<path d="M0 70q180-40 350 20t350-20 300 20" fill="none" stroke="{c}" stroke-width="10"/>'
   105	              f'<path d="M0 70q180-40 350 20t350-20 300 20" fill="none" stroke="{d}" stroke-width="4" stroke-dasharray="14 10"/>')
   106	        for px in (260, 620, 910):
   107	            s += f'<circle cx="{px}" cy="80" r="14" fill="{mix(b, .6)}" stroke="{c}" stroke-width="3"/>'
   108	
   109	    elif world == 4:
   110	        # The Lantern Woods Guild: AUTHENTIC 16-BIT PIXEL ART AESTHETIC!
   111	        # High stepped-pixel woodland canopy (8px & 12px stepped pixel blocks)
   112	        for px in range(0, 1000, 24):
   113	            # Stepped pixel leaf clusters
   114	            py_base = 32 + (px % 48) // 4
   115	            s += f'<rect x="{px}" y="0" width="24" height="{py_base}" fill="{mix(a, .7)}"/>'
   116	            s += f'<rect x="{px+4}" y="{py_base}" width="16" height="8" fill="{mix(a, .85)}"/>'
   117	            s += f'<rect x="{px+8}" y="{py_base+8}" width="8" height="6" fill="{b}"/>'
   118	        # Pixel-hewn timber arch pillars at key bay seams
   119	        for tx in (332, 672):
   120	            s += (f'<rect x="{tx}" y="0" width="16" height="600" fill="{mix(b, .5)}"/>'
   121	                  f'<rect x="{tx-8}" y="40" width="32" height="8" fill="{mix(a, .6)}"/>'
   122	                  f'<rect x="{tx-4}" y="48" width="24" height="8" fill="{mix(a, .6)}"/>'
   123	                  f'<rect x="{tx}" y="56" width="16" height="8" fill="{mix(a, .6)}"/>')
   124	        # Hanging pixel iron lanterns with dithered warm amber light halos
   125	        for lx in (170, 500, 830):
   126	            s += (f'<rect x="{lx+6}" y="48" width="4" height="24" fill="{mix(d, .4)}"/>'
   127	                  # Pixel lantern casing
   128	                  f'<rect x="{lx}" y="72" width="16" height="20" fill="{mix(d, .3)}"/>'
   129	                  f'<rect x="{lx+2}" y="74" width="12" height="16" fill="{c}"/>'
   130	                  # Stepped pixel light glow halo
   131	                  f'<rect x="{lx-8}" y="68" width="32" height="28" fill="{c}" opacity=".15"/>'
   132	                  f'<rect x="{lx-16}" y="60" width="48" height="44" fill="{c}" opacity=".08"/>')
   133	        # Dithered pixel cobblestones along the ground promenade
   134	        for cx in range(10, 990, 32):
   135	            cy_step = 290 + (cx % 3) * 6
   136	            s += f'<rect x="{cx}" y="{cy_step}" width="18" height="10" fill="{mix(b, .4)}" stroke="{mix(a, .6)}" stroke-width="1"/>'
   137	
   138	    elif world == 5:
   139	        # The Coffee House Crew: exposed terracotta brick masonry, arched sunlit window, sofa lounge
   140	        # Brick masonry pattern
   141	        for by in range(0, 270, 18):
   142	            offset = 16 if (by // 18) % 2 == 1 else 0
   143	            for bx in range(-20, 1020, 48):
   144	                s += f'<rect x="{bx + offset}" y="{by}" width="44" height="14" rx="2" fill="{mix(a, .3)}" stroke="{mix(d, .15)}" stroke-width="1"/>'
   145	        # Center arched window showing sunny city brownstones
   146	        s += (f'<path d="M410 240V110q90-70 180 0v130z" fill="{mix(d, .85)}" stroke="{mix(a, .7)}" stroke-width="6"/>'
   147	              f'<path d="M410 160h180M500 70v170" stroke="{mix(a, .7)}" stroke-width="4"/>')
   148	        # Hanging amber pendant light cones
   149	        for lx in (230, 770):
   150	            s += (f'<line x1="{lx}" y1="0" x2="{lx}" y2="60" stroke="{mix(d, .5)}" stroke-width="2"/>'
   151	                  f'<path d="M{lx-16} 72l16-12 16 12z" fill="{c}"/>'
