     1	"""World-specific architectural backdrops and station styling for overlay themes.
     2	
     3	Authored to evoke the specific creative lineage of each world with unmistakable
     4	atmosphere while adhering to docs/overlay-themes/originality.md (original vector
     5	geometry only, no trademarked marks, logos, character likenesses, or external assets).
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	
    11	def mix(hexcolor: str, ratio: float, base=(15, 25, 35)) -> str:
    12	    rgb = tuple(int(hexcolor[i:i+2], 16) for i in (1, 3, 5))
    13	    return '#' + ''.join(f'{round(c * ratio + b * (1 - ratio)):02x}' for c, b in zip(rgb, base))
    14	
    15	
    16	def backdrop(world: int, a: str, b: str, c: str, d: str, dark: str, light: str, accent: str, rng) -> str:
    17	    """Generate the rich world-specific architectural scenery behind the floor stations."""
    18	    s = ''
    19	
    20	    if world == 0:
    21	        # The Monster Mailroom: industrial pneumatic dispatch warehouse, overhead door tracks & delivery tubes
    22	        # Ceiling girder truss
    23	        s += f'<path d="M0 45h1000M0 55h1000" stroke="{mix(b, .4)}" stroke-width="3"/>'
    24	        for x in range(30, 1000, 60):
