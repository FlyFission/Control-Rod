   249	        for px in (440, 480, 520, 560):
   250	            s += f'<rect x="{px}" y="280" width="5" height="18" fill="{c}"/>'
   251	
   252	    elif world == 11:
   253	        # Thimble Town: giant wooden desk drawer with dovetails, giant thread spools as pillars, steel needle ladder
   254	        # Giant wooden drawer dovetail corners and drop-pulls
   255	        s += f'<rect x="0" y="0" width="1000" height="60" fill="{mix(a, .35)}" stroke="{mix(c, .4)}" stroke-width="3"/>'
   256	        for dx in range(0, 1000, 80):
   257	            s += f'<path d="M{dx} 0l16 28h24l16-28z" fill="{mix(a, .25)}" stroke="{mix(c, .3)}" stroke-width="1.5"/>'
   258	        # Brass drawer drop-pull in upper center
   259	        s += (f'<circle cx="500" cy="30" r="14" fill="{mix(c, .6)}" stroke="{d}" stroke-width="3"/>'
   260	              f'<path d="M480 30q20 30 40 0" fill="none" stroke="{d}" stroke-width="4"/>')
   261	        # Giant thread spools wound with colored baker\'s twine as architectural pillars
   262	        for sx in (326, 666):
   263	            s += (f'<rect x="{sx-12}" y="60" width="40" height="12" rx="4" fill="{mix(a, .5)}"/>'
   264	                  f'<rect x="{sx-8}" y="72" width="32" height="160" fill="{c}"/>'
   265	                  f'<rect x="{sx-12}" y="232" width="40" height="12" rx="4" fill="{mix(a, .5)}"/>')
   266	            for ty in range(80, 230, 14):
   267	                s += f'<line x1="{sx-8}" y1="{ty}" x2="{sx+24}" y2="{ty}" stroke="{d}" stroke-width="3"/>'
   268	        # Giant steel sewing needle leaning diagonally as a ladder
   269	        s += (f'<line x1="880" y1="50" x2="940" y2="280" stroke="{d}" stroke-width="6" stroke-linecap="round"/>'
   270	              f'<ellipse cx="886" cy="74" rx="3" ry="12" fill="{mix(a, .3)}" transform="rotate(18 886 74)"/>'
   271	              f'<path d="M886 74q-30 20-10 60" fill="none" stroke="{c}" stroke-width="3"/>')
   272	
   273	    elif world == 12:
   274	        # Clockwork Stargazers: giant interlocking brass gear trains, astrolabe armillary rings, pendulum
   275	        # Giant interlocking brass gear wheels across ceiling
   276	        def gear(gx: int, gy: int, r: int, teeth: int = 12, col=c):
   277	            g_str = f'<circle cx="{gx}" cy="{gy}" r="{r}" fill="{mix(col, .35)}" stroke="{col}" stroke-width="3"/>'
   278	            for t_i in range(teeth):
   279	                angle = (360 / teeth) * t_i
   280	                g_str += f'<rect x="{gx-4}" y="{gy-r-6}" width="8" height="8" rx="2" fill="{col}" transform="rotate({angle} {gx} {gy})"/>'
   281	            g_str += f'<circle cx="{gx}" cy="{gy}" r="{r//3}" fill="{mix(a, .4)}" stroke="{d}" stroke-width="2"/>'
   282	            return g_str
   283	
   284	        s += gear(170, 70, 48, 14)
   285	        s += gear(256, 70, 36, 10, col=d)
   286	        s += gear(500, 60, 54, 16)
   287	        s += gear(740, 70, 36, 10, col=d)
   288	        s += gear(826, 70, 48, 14)
   289	        # Concentric astrolabe armillary degree rings in background
