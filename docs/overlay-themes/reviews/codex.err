   215	def scene(world,entry):
   216	    a,b,c,d=entry['palette'];dark=mix(a,.18);light=mix(a,.65);accent=mix(c,.7,(255,230,195));rng=random.Random(world+17)
   217	    s=(f'<defs>'
   218	       f'<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{mix(a,.42)}"/><stop offset="1" stop-color="{dark}"/></linearGradient>'
   219	       f'<linearGradient id="desk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{mix(c,.65)}"/><stop offset="1" stop-color="{mix(b,.4)}"/></linearGradient>'
   220	       f'<radialGradient id="ambient" cx="50%" cy="50%" r="65%"><stop offset="0" stop-color="{mix(c,.25,(255,255,255))}" stop-opacity=".14"/><stop offset="100%" stop-color="{dark}" stop-opacity="0"/></radialGradient>'
   221	       f'</defs>'
   222	       f'<rect width="1000" height="600" fill="url(#sky)"/>'
   223	       f'<rect width="1000" height="600" fill="url(#ambient)"/>')
   224	    # World-specific architectural backdrop
   225	    s+=theme_art_backdrops.backdrop(world,a,b,c,d,dark,light,accent,rng)
   226	    # Central shared promenade, with a world-specific routing language.
   227	    s+=f'<path d="M0 286h1000v30H0z" fill="{mix(b,.28)}"/><path d="M20 300h960" stroke="{accent}" stroke-width="2" stroke-dasharray="4 12" opacity=".45"/>'
   228	    if world in (0,1,3,7):
   229	        s+=f'<path d="M0 277h1000M0 323h1000" stroke="{mix(c,.65)}" stroke-width="8"/>'
   230	        for x in range(40,1000,110):s+=f'<circle cx="{x}" cy="300" r="12" fill="{mix(a,.65)}" stroke="{d}" stroke-width="2"/><circle cx="{x}" cy="300" r="4" fill="{accent}"/>'
   231	    if world in (10,13):s+=f'<path d="M0 298q125-25 250 0t250 0 250 0 250 0" fill="none" stroke="{mix(d,.7)}" stroke-width="10" opacity=".3"/>'
   232	    for index,(key,r) in enumerate(STATIONS.items()):
   233	        x,y,w,h=r['x'],r['y'],r['w'],r['h'];rounding=26 if world in (4,8,10,13,14) else 9 if world in (2,7,9,12) else 17
   234	        s+=f'<rect x="{x+3}" y="{y+7}" width="{w}" height="{h}" rx="{rounding}" fill="#071422" opacity=".35"/><rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{rounding}" fill="{mix(a,.32)}" stroke="{mix(d,.45)}" stroke-width="1.5"/>'
   235	        # Quiet station header plate beneath title
   236	        s+=f'<rect x="{x+1}" y="{y+1}" width="{w-2}" height="32" rx="{rounding-1}" fill="{mix(a,.22)}" opacity=".75"/><rect x="{x+1}" y="{y+18}" width="{w-2}" height="14" fill="{mix(a,.22)}" opacity=".75"/><line x1="{x+12}" y1="{y+32}" x2="{x+w-12}" y2="{y+32}" stroke="{mix(d,.35)}" stroke-width="1"/>'
   237	        s+=f'<path d="M{x+14} {y+h-30}h{w-28}l-8 15H{x+22}z" fill="url(#desk)"/><path d="M{x+22} {y+h-15}v7h{w-44}v-7" fill="{mix(b,.35)}"/>'
   238	        for col in range(3):
   239	            sx=x+w*(col+.5)/3
   240	            s+=f'<ellipse cx="{sx}" cy="{y+110}" rx="30" ry="8" fill="#d9ecdb" opacity=".07"/><ellipse cx="{sx}" cy="{y+195}" rx="30" ry="8" fill="#d9ecdb" opacity=".07"/>'
   241	        # Each room receives a handcrafted environmental vignette at its quiet edge.
   242	        s+=vignette(world,x+w-42,y+22,entry['palette'])
   243	        # Small instrument indicators are decorative; no numbers or fake progress.
   244	        for j in range(3):s+=f'<circle cx="{x+22+j*9}" cy="{y+h-22}" r="2" fill="{d}" opacity=".55"/>'
   245	    if world==12:
   246	        s+=f'<circle cx="500" cy="300" r="25" fill="{dark}" stroke="{c}" stroke-width="2"/>'+star(500,300,15,d)
   247	    return svg(s,1000,600)
