   179	        # Curved radiant planet limb in upper space
   180	        s += (f'<path d="M680 0q180 80 320 220V0z" fill="{b}" opacity=".6"/>'
   181	              f'<path d="M680 0q180 80 320 220" fill="none" stroke="{c}" stroke-width="8" opacity=".8"/>')
   182	        # Massive heavy-duty overhead gantry crane with hazard chevrons
   183	        s += f'<rect x="0" y="32" width="1000" height="20" fill="{mix(a, .4)}" stroke="{mix(d, .4)}" stroke-width="2"/>'
   184	        for hx in range(0, 1000, 36):
   185	            s += f'<polygon points="{hx},32 {hx+14},32 {hx+22},52 {hx+8},52" fill="{c}"/>'
   186	        # Vertical structural blast-door bay bulkheads
   187	        for bx in (332, 672):
   188	            s += (f'<rect x="{bx}" y="0" width="14" height="600" fill="{mix(a, .3)}" stroke="{mix(d, .5)}" stroke-width="2"/>'
   189	                  f'<line x1="{bx+7}" y1="52" x2="{bx+7}" y2="580" stroke="{c}" stroke-width="2" stroke-dasharray="10 20"/>')
   190	
   191	    elif world == 8:
   192	        # Critter Expedition Camp: AUTHENTIC 16-BIT PIXEL ART AESTHETIC!
   193	        # Stepped pixel canvas field tents in background
   194	        for tx in (120, 800):
   195	            # Stepped pixel tent triangle
   196	            s += (f'<polygon points="{tx},60 {tx-60},160 {tx+60},160" fill="{d}"/>'
   197	                  f'<polygon points="{tx},60 {tx-12},160 {tx+12},160" fill="{mix(a, .5)}"/>'
   198	                  f'<line x1="{tx}" y1="60" x2="{tx}" y2="40" stroke="{mix(b, .5)}" stroke-width="3"/>')
   199	        # Stone-ringed pixel campfire in center promenade
   200	        s += (f'<ellipse cx="500" cy="300" rx="34" ry="14" fill="{mix(a, .3)}"/>'
   201	              f'<circle cx="475" cy="298" r="7" fill="{mix(b, .6)}"/>'
   202	              f'<circle cx="492" cy="304" r="8" fill="{mix(b, .6)}"/>'
   203	              f'<circle cx="510" cy="303" r="7" fill="{mix(b, .6)}"/>'
   204	              f'<circle cx="525" cy="298" r="6" fill="{mix(b, .6)}"/>'
