   305	        # Sunken ship anchor half-buried on seabed
   306	        s += (f'<circle cx="500" cy="275" r="14" fill="none" stroke="{mix(a, .6)}" stroke-width="4"/>'
   307	              f'<line x1="500" y1="289" x2="500" y2="350" stroke="{mix(a, .6)}" stroke-width="6"/>'
   308	              f'<path d="M470 335q30 25 60 0" fill="none" stroke="{mix(a, .6)}" stroke-width="6" stroke-linecap="round"/>')
   309	
   310	    elif world == 14:
   311	        # Cozy Critter Village: ancient oak tree root burrow arch, stone chimney with smoke, postboxes
   312	        # Massive gnarled oak tree root arch framing the ceiling
   313	        s += (f'<path d="M0 80q250-90 500-40t500 40v30q-250-40-500-40t-500 40z" fill="{mix(a, .6)}"/>'
   314	              f'<path d="M120 70q-30 80-60 180M880 70q30 80 60 180" stroke="{mix(a, .7)}" stroke-width="18" fill="none"/>')
   315	        # Stone chimney with soft curling woodsmoke puffs
   316	        s += (f'<rect x="475" y="70" width="36" height="54" fill="{mix(b, .4)}" stroke="{mix(d, .5)}" stroke-width="2"/>'
   317	              f'<path d="M493 70q-15-25 0-45t25-10" fill="none" stroke="{d}" stroke-width="3" opacity=".6"/>'
   318	              f'<circle cx="510" cy="24" r="6" fill="{d}" opacity=".4"/>')
   319	        # Rustic wooden mailboxes with red flags along pathway
   320	        for mx in (70, 910):
   321	            s += (f'<rect x="{mx}" y="240" width="6" height="40" fill="{mix(b, .5)}"/>'
   322	                  f'<rect x="{mx-8}" y="222" width="22" height="18" rx="6" fill="{d}" stroke="{b}" stroke-width="2"/>'
   323	                  f'<path d="M{mx+14} 226h8v4h-8z" fill="#ff4444"/>')
   324	
   325	    return s

