   250	def preflight(entries,briefs):
   251	    """Every problem that would stop the build, found before any file is written."""
   252	    from theme_art_props import PROPS
   253	    problems=[]
   254	    ids=[e['id'] for e in entries]
   255	    if len(set(ids))!=len(ids):problems.append('duplicate pack IDs in catalog.ts')
   256	    for pid in ids:
   257	        names=briefs.get(pid)
   258	        if names is None:problems.append(f'{pid}: no prop brief in the catalog spec');continue
   259	        if len(names)!=6:problems.append(f'{pid}: prop brief lists {len(names)} props; exactly six are required')
   260	        for name in names:
   261	            if name not in PROPS:problems.append(f'{pid}: no drawing for prop {name!r} in tools/theme_art_props.py')
   262	    for pid in sorted(set(briefs)-set(ids)):problems.append(f'{pid}: prop brief has no catalog entry')
   263	    return problems
   264	
