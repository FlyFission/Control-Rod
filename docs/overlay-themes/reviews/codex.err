    90	def check_release_records(records, manifests):
    91	    if not isinstance(records, list):
    92	        return ['Release manifest must be an array']
    93	    errors, seen = [], set()
    94	    for record in records:
    95	        if not isinstance(record, dict):
    96	            errors.append('Invalid release record')
    97	            continue
    98	        pid = record.get('packId')
    99	        manifest = manifests.get(pid)
   100	        if pid in seen or not manifest:
   101	            errors.append(f'{pid}: duplicate or unknown release pack')
   102	            continue
   103	        seen.add(pid)
   104	        if any(not isinstance(record.get(k),str) or not record[k].strip() for k in ['id','version','title','reviewer','reviewedAt','evidence','distribution']):
   105	            errors.append(f'{pid}: incomplete release decision')
   106	        if record.get('approvedInfluenceText') != '':
   107	            errors.append(f'{pid}: influence text must be an explicit empty string (docs/overlay-themes/originality.md)')
   108	        if record.get('version') != manifest.get('version') or record.get('title') != manifest.get('title') or record.get('assets') != [a['sha256'] for a in manifest['assets']]:
   109	            errors.append(f'{pid}: release does not bind actual art, version and title')
