   215	        # Blockworks Foundry: AUTHENTIC ISOMETRIC 3D VOXEL PIXEL AESTHETIC!
   216	        # Stepped 3D isometric voxel terrain and quarry blocks
   217	        def voxel_cube(vx: int, vy: int, size: int = 24, top_col=c, left_col=a, right_col=b):
   218	            h_s = size // 2
   219	            # 3-faced isometric cube
   220	            top = f'M{vx} {vy}l{size} -{h_s} {size} {h_s}-{size} {h_s}z'
   221	            left = f'M{vx} {vy}l0 {size} {size} {h_s} 0 -{size}z'
   222	            right = f'M{vx+size} {vy+h_s}l0 {size} {size} -{h_s} 0 -{size}z'
   223	            return f'<path d="{top}" fill="{top_col}"/><path d="{left}" fill="{left_col}"/><path d="{right}" fill="{right_col}"/>'
