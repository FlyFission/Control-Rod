{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "AuthenticatorCredential.json",
    "type": "object",
    "properties": {
        "id": {
            "$ref": "TenancyId.json"
        },
        "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        },
        "org_id": {
            "$ref": "TenancyId.json"
        },
        "member_id": {
            "$ref": "TenancyId.json"
        },
        "credential_id": {
            "type": "string",
            "description": "The WebAuthn credential id (base64url)."
        },
        "attestation_format": {
            "$ref": "AttestationFormat.json"
        },
        "aaguid": {
            "type": "string",
            "description": "Authenticator model identifier when attested."
        },
        "user_verified": {
            "type": "boolean"
        },
        "backup_eligible": {
            "type": "boolean",
            "description": "Whether the credential may be synced between devices (multi-device). Absent when the\nregistration did not record it (passkeys registered before migration 009)."
        },
        "hardware_floor": {
            "$ref": "HardwareFloorVerdict.json"
        },
        "revoked": {
            "type": "boolean",
            "description": "A revoked credential signs nothing and cannot sign in. Revocation is a new version."
        },
        "recorded_at": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "id",
        "version",
        "org_id",
        "member_id",
        "credential_id",
        "attestation_format",
        "user_verified",
        "hardware_floor",
        "recorded_at"
    ],
    "description": "A Member's passkey with its registration evidence. One frozen version per change.",
    "unevaluatedProperties": false
}