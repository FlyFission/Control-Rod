{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "BaseLinesAnchor.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "base-lines"
        },
        "path": {
            "$ref": "AnchorPath.json"
        },
        "start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        },
        "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        }
    },
    "required": [
        "kind",
        "path",
        "start",
        "end"
    ],
    "description": "Lines in the base tree that the change removed or changed. Diff targets only.",
    "unevaluatedProperties": false
}