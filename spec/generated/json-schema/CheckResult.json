{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "CheckResult.json",
    "type": "object",
    "properties": {
        "check_id": {
            "type": "string"
        },
        "outcome": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "pass"
                },
                {
                    "type": "string",
                    "const": "fail"
                },
                {
                    "type": "string",
                    "const": "inconclusive"
                },
                {
                    "type": "string",
                    "const": "open"
                },
                {
                    "type": "string",
                    "const": "deferred"
                }
            ]
        },
        "evidence_refs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "check_id",
        "outcome",
        "evidence_refs"
    ],
    "unevaluatedProperties": false
}