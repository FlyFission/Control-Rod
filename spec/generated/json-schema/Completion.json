{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Completion.json",
    "type": "object",
    "properties": {
        "claim_token": {
            "type": "string"
        },
        "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "description": "Chosen by the daemon once per completion and kept across retries."
        },
        "status": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "succeeded"
                },
                {
                    "type": "string",
                    "const": "failed"
                },
                {
                    "type": "string",
                    "const": "stopped"
                }
            ],
            "description": "\"stopped\" only after the owner asked to stop the run."
        },
        "error": {
            "type": "string"
        },
        "trace": {
            "$ref": "ExecutionTrace.json"
        },
        "outputs": {
            "type": "array",
            "items": {
                "$ref": "NamedFile.json"
            }
        },
        "package": {
            "$ref": "WorkPackage.json"
        },
        "verification": {
            "$ref": "VerificationRecord.json"
        },
        "criterion_results": {
            "$ref": "CriterionResultSubmission.json"
        }
    },
    "required": [
        "claim_token",
        "idempotency_key",
        "status",
        "outputs"
    ],
    "unevaluatedProperties": false
}