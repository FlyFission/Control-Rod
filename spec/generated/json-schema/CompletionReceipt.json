{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "CompletionReceipt.json",
    "type": "object",
    "properties": {
        "run_id": {
            "type": "string"
        },
        "idempotency_key": {
            "type": "string"
        },
        "status": {
            "$ref": "RunStatus.json"
        },
        "outputs": {
            "type": "array",
            "items": {
                "$ref": "Artifact.json"
            }
        },
        "received_at": {
            "type": "string",
            "format": "date-time"
        },
        "refusal": {
            "$ref": "#/$defs/ApiError",
            "description": "Set when the completion could not be applied; the run is then recorded failed with this reason."
        }
    },
    "required": [
        "run_id",
        "idempotency_key",
        "status",
        "outputs",
        "received_at"
    ],
    "description": "What the control plane recorded for a completion. A repeat with the same key returns it again.",
    "unevaluatedProperties": false,
    "$defs": {
        "ApiError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "description": "A stable reason code (services/api/src/refusals.ts lists every one)."
                },
                "message": {
                    "type": "string"
                },
                "change": {
                    "type": "string",
                    "description": "The one fact that would change the answer (WB-03)."
                },
                "floor": {
                    "type": "boolean",
                    "description": "Set when a floor refused: no person, decision or setting lifts it."
                }
            },
            "required": [
                "code",
                "message"
            ]
        }
    }
}