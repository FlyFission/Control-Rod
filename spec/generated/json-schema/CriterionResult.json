{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "CriterionResult.json",
    "type": "object",
    "properties": {
        "criterion_id": {
            "type": "string"
        },
        "outcome": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "pass"
                },
                {
                    "type": "string",
                    "const": "fail"
                },
                {
                    "type": "string",
                    "const": "inconclusive"
                },
                {
                    "type": "string",
                    "const": "open"
                },
                {
                    "type": "string",
                    "const": "deferred"
                }
            ]
        },
        "check_results": {
            "type": "array",
            "items": {
                "$ref": "CheckResult.json"
            }
        },
        "finding_refs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "criterion_id",
        "outcome",
        "check_results",
        "finding_refs"
    ],
    "unevaluatedProperties": false
}