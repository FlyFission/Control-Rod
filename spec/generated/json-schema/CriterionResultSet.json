{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "CriterionResultSet.json",
    "type": "object",
    "properties": {
        "package_id": {
            "type": "string"
        },
        "package_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
        },
        "release_manifest_digest": {
            "$ref": "Digest.json"
        },
        "results": {
            "type": "array",
            "items": {
                "$ref": "CriterionResult.json"
            }
        },
        "verification_record_digest": {
            "$ref": "Digest.json"
        }
    },
    "required": [
        "package_id",
        "package_revision",
        "release_manifest_digest",
        "results",
        "verification_record_digest"
    ],
    "description": "Controller binds admitted checker results to the actual normalized verification record.",
    "unevaluatedProperties": false
}