{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "DecisionKindMapping.json",
    "type": "object",
    "properties": {
        "mapping_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        },
        "legacy_kind": {
            "$ref": "DecisionKind.json"
        },
        "plan_kind": {
            "$ref": "PlanDecisionKind.json"
        },
        "verdict_outcome": {
            "$ref": "VerdictOutcome.json",
            "description": "Present exactly when plan_kind is verdict."
        }
    },
    "required": [
        "mapping_version",
        "legacy_kind",
        "plan_kind"
    ],
    "description": "One row of a mapping version: how a legacy kind reads as a plan kind.",
    "unevaluatedProperties": false
}