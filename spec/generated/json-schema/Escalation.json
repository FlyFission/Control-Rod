{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Escalation.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "criterion_ids": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "reason": {
            "type": "string"
        },
        "alternatives": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "owner": {
            "type": "string"
        },
        "resolution_refs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "id",
        "criterion_ids",
        "reason",
        "alternatives",
        "owner",
        "resolution_refs"
    ],
    "unevaluatedProperties": false
}