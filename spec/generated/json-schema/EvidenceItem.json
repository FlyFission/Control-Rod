{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "EvidenceItem.json",
    "type": "object",
    "properties": {
        "claim": {
            "type": "string"
        },
        "status": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "pass"
                },
                {
                    "type": "string",
                    "const": "deferred"
                },
                {
                    "type": "string",
                    "const": "open"
                }
            ]
        },
        "artifact": {
            "$ref": "Artifact.json"
        },
        "custody": {
            "$ref": "Custody.json"
        }
    },
    "required": [
        "claim",
        "status",
        "custody"
    ],
    "unevaluatedProperties": false
}