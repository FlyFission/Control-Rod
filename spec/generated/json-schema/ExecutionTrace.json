{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ExecutionTrace.json",
    "type": "object",
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "0.1.0"
        },
        "run_id": {
            "type": "string"
        },
        "package_id": {
            "type": "string"
        },
        "package_revision": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
        },
        "agent_baseline": {
            "type": "string"
        },
        "baseline_revision": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
        },
        "tool": {
            "$ref": "ToolRef.json"
        },
        "inputs": {
            "type": "array",
            "items": {
                "$ref": "Artifact.json"
            }
        },
        "outputs": {
            "type": "array",
            "items": {
                "$ref": "Artifact.json"
            }
        },
        "environment": {
            "$ref": "#/$defs/RecordString"
        },
        "started_at": {
            "type": "string",
            "format": "date-time"
        },
        "finished_at": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "schema_version",
        "run_id",
        "package_id",
        "package_revision",
        "agent_baseline",
        "baseline_revision",
        "tool",
        "inputs",
        "outputs",
        "started_at",
        "finished_at"
    ],
    "description": "Proof of where outputs came from. Recorded by the runner, never by the agent.",
    "unevaluatedProperties": false,
    "$defs": {
        "RecordString": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {
                "type": "string"
            }
        }
    }
}