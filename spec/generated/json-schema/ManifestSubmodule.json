    "$id": "ManifestSubmodule.json",
    "type": "object",
    "properties": {
        "path": {
            "type": "string"
        },
        "url": {
            "type": "string"
        },
        "commit": {
            "$ref": "GitObjectId.json"
        }
    },
    "required": [
