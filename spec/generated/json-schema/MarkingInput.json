{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "MarkingInput.json",
    "type": "object",
    "properties": {
        "object_kind": {
            "type": "string"
        },
        "object_id": {
            "type": "string"
        },
        "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        }
    },
    "required": [
        "object_kind",
        "object_id",
        "version"
    ],
    "description": "A provenance edge: the marking version of an object another object was derived from.",
    "unevaluatedProperties": false
}