{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Organization.json",
    "type": "object",
    "properties": {
        "id": {
            "$ref": "TenancyId.json"
        },
        "name": {
            "type": "string"
        },
        "status": {
            "$ref": "LifecycleStatus.json"
        }
