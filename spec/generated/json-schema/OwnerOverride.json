{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "OwnerOverride.json",
    "type": "object",
    "properties": {
        "by": {
            "type": "string"
        },
        "at": {
            "type": "string",
            "format": "date-time"
        },
        "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
        },
        "subject_digest": {
            "$ref": "Digest.json"
        },
        "assertion": {
            "$ref": "PasskeyAssertion.json"
        }
    },
    "required": [
        "by",
        "at",
        "reason",
        "subject_digest",
        "assertion"
    ],
    "description": "A person's choice to proceed past a hold, with who, when and why, signed with their passkey\nover the digest of (package, revision, run, the act and the reason).",
    "unevaluatedProperties": false
}