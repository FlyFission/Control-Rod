{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "PreparationCheck.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "criterion_ids": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "method": {
            "type": "string"
        },
        "required": {
            "type": "boolean"
        },
        "expected_result": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "criterion_ids",
        "method",
        "required",
        "expected_result"
    ],
    "unevaluatedProperties": false
}