{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "PreparationTask.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        },
        "design_element_ids": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "depends_on": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "id",
        "description",
        "design_element_ids",
        "depends_on"
    ],
    "unevaluatedProperties": false
}