{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ScramEvent.json",
    "type": "object",
    "properties": {
        "id": {
            "$ref": "TenancyId.json"
        },
        "org_id": {
            "$ref": "TenancyId.json"
        },
        "scope": {
            "$ref": "ScramScope.json"
        },
        "project_id": {
            "$ref": "TenancyId.json"
        },
        "pulled_by": {
            "$ref": "TenancyId.json"
        },
        "reason": {
            "type": "string",
            "minLength": 1
        },
        "assertion": {
            "$ref": "PasskeyAssertion.json"
        },
        "quarantine": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Run ids stopped, with their outputs quarantined."
        }
    },
    "required": [
        "id",
        "org_id",
        "scope",
        "pulled_by",
        "reason",
        "assertion",
        "quarantine"
    ],
    "description": "Who pulled SCRAM, where, why, and what was stopped. (A)",
    "unevaluatedProperties": false
}